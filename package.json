{
  "name": "monster-impact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:core": "node --experimental-strip-types --test tests/core/*.test.mjs",
    "test": "npm run typecheck && npm run test:core",
    "serve": "python -m http.server 8080",
    "start": "python scripts/launch_game.py",
    "launch": "python scripts/launch_game.py"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
